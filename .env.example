# Local database used by the synthetic demo seed.
DATABASE_URL="file:dev.db"

# Public portfolio mode fails safe: external side effects stay disabled unless
# this is explicitly set to false in a private, isolated deployment.
PUBLIC_DEMO="true"

# Hosted portfolio deployments copy the committed synthetic database template
# into ephemeral runtime storage. Never enable this in the private app.
HOSTED_DEMO="false"

# Generate a unique value locally and in the demo deployment. It is used only
# to sign the HTTP-only demo session cookie and must contain at least 32 characters.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Optional isolated demo infrastructure. Never point these at production.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
DEMO_TOUR_ENABLED=true
BLOB_READ_WRITE_TOKEN=""

# Production integrations are intentionally disabled while PUBLIC_DEMO=true.
RESEND_API_KEY=""
TRELLO_API_KEY=""
TRELLO_TOKEN=""
TRELLO_BOARD_ID=""
