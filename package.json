{
  "name": "levelos-trades-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Sanitized portfolio edition of a production pool-builder operations system.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run audit:images && npm run audit:brand && npm run build",
    "db:push": "node scripts/prisma-db-push.mjs",
    "db:seed": "tsx scripts/seed-demo.ts",
    "demo:setup": "prisma generate && node scripts/prisma-db-push.mjs && tsx scripts/seed-demo.ts",
    "demo:template": "prisma generate && node scripts/build-demo-template.mjs",
    "audit:images": "tsx scripts/audit-demo-images.ts",
    "audit:brand": "tsx scripts/audit-brand.ts",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs",
    "demo:tokens": "tsx scripts/list-tokens.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/blob": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.564.0",
    "next": "^16.3.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.4.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "prisma": "^7.9.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  }
}
